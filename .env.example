# Copy to .env and fill in. .env is git-ignored.
APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://advancedrag:advancedrag@localhost:5432/advancedrag
REDIS_URL=redis://localhost:6379/0

# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: more keys. When the best model is rate-limited on one key, the gateway
# tries it on the next key before falling back to a smaller model.
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Daily token budget for the primary model; past it, requests use the cheaper model.
# 0 turns it off (ADR 0011).
LLM_DAILY_TOKEN_BUDGET=1000000
